{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../../../../node_modules/.tmp/tsconfig.cubism.tsbuildinfo",
    "outDir": "../../../../node_modules/.tmp/cubism-framework",
    "rootDir": ".",
